\contentsline {figure}{\numberline {5.1}{\ignorespaces Repository asset showing the apple motion-editing case used as the primary qualitative example.}}{18}{}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Frontend experiment console using the apple translation preset. The interface exposes prompt, input folder, mask, primitive motion, guidance, and runtime controls. It is included as implementation evidence and is not counted as a separate quantitative experiment.}}{22}{}%
\contentsline {figure}{\numberline {7.1}{\ignorespaces Recorded flow-loss trajectories for the apple ablation. RAFT-guided primitive diffusion reaches lower flow loss than the no-RAFT variant across the three seeds.}}{33}{}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Total guidance-energy trajectories for the apple ablation. RAFT-guided variants have lower final energy than the no-RAFT diffusion condition.}}{34}{}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Final saved apple outputs. Rows are seeds 0--2. Columns are warp-inpaint-only, original Motion Guidance, diffusion without RAFT, diffusion with RAFT, and full pipeline. The full pipeline is visually strong, but its final image is composited.}}{34}{}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Pre-composite apple outputs for primitive diffusion variants. Rows are seeds 0--2. Columns are no-RAFT diffusion, RAFT-guided diffusion, and full-pipeline pre-composite output. These images separate diffusion behavior from final compositing.}}{35}{}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Additional teapot translation case over three seeds. Columns show source, warped initialization, decoded diffusion output, and final composited output.}}{37}{}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Additional tree file-flow squeeze case over three seeds. This case is useful as a stress test; it should not be presented as a polished rigid-translation result.}}{38}{}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Representative apple outputs from the compact hyperparameter study. The grid shows source, hard-warp initialization, decoded diffusion output, and final pre-composite output for each setting.}}{40}{}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Apple source-hole restoration comparison using the same moved object and source-hole mask. LaMa is visually cleaner than the local, directional, and OpenCV fills in this case and is therefore used as the final selected restoration.}}{41}{}%
\contentsline {figure}{\numberline {10.1}{\ignorespaces Apple result asset used as the main qualitative evidence for controllable rigid object translation.}}{67}{}%
\contentsline {figure}{\numberline {10.2}{\ignorespaces Final outputs from the apple ablation. This grid supports the qualitative comparison in Chapter\nobreakspace {}7\hbox {}.}}{69}{}%
\contentsline {figure}{\numberline {10.3}{\ignorespaces Pre-composite outputs for primitive diffusion variants. Rows are seeds 0--2; columns are no-RAFT diffusion, RAFT-guided diffusion, and the full-pipeline pre-composite output.}}{70}{}%
\contentsline {figure}{\numberline {10.4}{\ignorespaces Additional teapot translation runs over seeds 0--2. Columns show source, warped initialization, decoded diffusion output, and final composited output.}}{71}{}%
\contentsline {figure}{\numberline {10.5}{\ignorespaces Additional tree file-flow squeeze runs over seeds 0--2. The case is useful for diagnosing non-rigid/file-flow behavior, not for claiming polished non-rigid editing.}}{72}{}%
